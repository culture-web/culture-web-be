# Copy this file to .env and replace each placeholder with the appropriate value.
# Never commit real credentials.

# AWS / S3
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=ap-southeast-1
S3_BUCKET_NAME=your-s3-bucket-name

# PostgreSQL configuration (legacy RDS integration - deprecated)
DB_USER=your-rds-user
DB_HOST=your-rds-host
DB_NAME=your-rds-database
DB_PASSWORD=your-rds-password
DB_PORT=5432

# Server
PORT=3001
BACKEND_BASE_URL=http://localhost:3001

# Hugging Face
HF_TOKEN=your-hugging-face-token

# Supabase DEVELOPMENT project only. Production cxtsnupbfqqosvzhwqyw is separate.
# See docs/development-environment.md; frontend must use the same project.
SUPABASE_URL=https://rzokzctxdqagnmhqhrqd.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Supabase JWT / JWKS
SUPABASE_JWT_ISSUER=https://rzokzctxdqagnmhqhrqd.supabase.co/auth/v1
SUPABASE_JWKS_URL=https://rzokzctxdqagnmhqhrqd.supabase.co/auth/v1/.well-known/jwks.json

# External KB PostgreSQL/pgvector: obtain an isolated dev destination.
LOCAL_DB_HOST=your-development-kb-host
LOCAL_DB_PORT=5432
LOCAL_DB_USER=your-development-kb-user
LOCAL_DB_PASSWORD=your-development-kb-password
LOCAL_DB_NAME=your-development-kb-database

# External MinIO: hostname only; obtain isolated dev storage from maintainer.
MINIO_ENDPOINT=your-development-minio-host
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=your-development-minio-access-key
MINIO_SECRET_KEY=your-development-minio-secret-key
MINIO_BUCKET=your-development-kb-bucket

# Scheduled jobs
BHASKARS_BASE_URL=https://www.bhaskarsartsacademy.com

# Groq (legacy fallback)
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-120b

# NUS SoC LaaS (LLM-as-a-Service - preferred)
SOCLAAS_BASE_URL=https://soclaas-api.comp.nus.edu.sg/v1
SOCLAAS_API_KEY=your-soclaas-api-key
SOCLAAS_MODEL=default
