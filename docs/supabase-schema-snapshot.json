  "constraints": [
    {
      "table_name": "events",
      "conname": "events_pkey",
      "definition": "PRIMARY KEY (id)"
    },
    {
      "table_name": "events",
      "conname": "events_url_key",
      "definition": "UNIQUE (url)"
    },
    {
      "table_name": "messages",
      "conname": "messages_pkey",
      "definition": "PRIMARY KEY (id)"
    },
    {
      "table_name": "messages",
      "conname": "messages_role_check",
      "definition": "CHECK ((role = ANY (ARRAY['system'::text, 'user'::text, 'assistant'::text])))"
    },
    {
      "table_name": "music",
      "conname": "music_pkey",
      "definition": "PRIMARY KEY (id)"
    },
    {
      "table_name": "ornaments",
      "conname": "ornaments_pkey",
      "definition": "PRIMARY KEY (id)"
    },
    {
      "table_name": "quiz_question",
      "conname": "quiz_question_pkey",
      "definition": "PRIMARY KEY (id)"
    },
    {
      "table_name": "quiz_session",
      "conname": "quiz_session_pkey",
      "definition": "PRIMARY KEY (id)"
    },
    {
      "table_name": "sessions",
      "conname": "sessions_pkey",
      "definition": "PRIMARY KEY (id)"
    },
    {
      "table_name": "user_proficiency_state",
      "conname": "user_proficiency_state_pkey",
      "definition": "PRIMARY KEY (user_id, node_id)"
    },
    {
      "table_name": "messages",
      "conname": "fk_messages_response_for",
      "definition": "FOREIGN KEY (response_for) REFERENCES messages(id) ON DELETE CASCADE"
    },
    {
      "table_name": "messages",
      "conname": "messages_session_id_fkey",
      "definition": "FOREIGN KEY (session_id) REFERENCES sessions(id) ON DELETE CASCADE"
    },
    {
      "table_name": "quiz_question",
      "conname": "quiz_question_quiz_id_fkey",
      "definition": "FOREIGN KEY (quiz_id) REFERENCES quiz_session(id) ON DELETE CASCADE"
    },
    {
      "table_name": "sessions",
      "conname": "sessions_user_id_fkey",
      "definition": "FOREIGN KEY (user_id) REFERENCES auth.users(id)"
    }
  ],
